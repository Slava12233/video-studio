# Video Studio keys. Copy this file to ".env" and fill the values. ".env" is git-ignored and never printed.

# fal.ai API key (fal.ai -> Dashboard -> Keys). Needed for AI generation, TTS, avatars and Hebrew transcription.
FAL_KEY=

# Optional hard cap on fal.ai spend per project, in USD. Empty = no cap (default):
# every paid step still prints its estimate and waits for an explicit go.
STUDIO_BUDGET_USD=

# Optional: queue wait for one fal job in ms (default 20 minutes).
# FAL_QUEUE_TIMEOUT_MS=1200000
